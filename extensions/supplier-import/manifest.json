{
  "manifest_version": 3,
  "name": "__MSG_extensionName__",
  "description": "__MSG_extensionDescription__",
  "version": "0.4.3",
  "default_locale": "ru",
  "permissions": ["activeTab", "scripting", "clipboardWrite"],
  "action": { "default_popup": "popup.html", "default_title": "__MSG_extensionName__" },
  "content_security_policy": { "extension_pages": "script-src 'self'; object-src 'none'; connect-src 'none'; style-src 'self'; img-src 'self'" },
  "browser_specific_settings": {
    "gecko": {
      "id": "supplier-import@all-vp-n.ru",
      "strict_min_version": "142.0",
      "update_url": "https://github.com/UnidentifiedSheep/ecommerce-extensions/releases/latest/download/firefox-updates.json",
      "data_collection_permissions": { "required": ["none"] }
    }
  }
}
